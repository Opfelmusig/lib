{
  "name": "@opfelmusig/lib",
  "version": "0.0.1",
  "description": "A fully typed Apple Music API client",
  "keywords": [
    "apple-music",
    "apple-music-api",
    "musickit",
    "typescript"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/opfelmusig/lib.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    "./helpers": {
      "types": "./dist/helpers/public.d.ts",
      "import": "./dist/helpers/public.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix --fix-suggestions",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "setup": "lefthook install",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "bun x concurrently \"tsc -p tsconfig.build.json -w\" \"tsc-alias -p tsconfig.build.json -w\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "thisval": "^0.1.1",
    "tsc-alias": "^1.9.9",
    "typescript": "^7.0.2"
  }
}
